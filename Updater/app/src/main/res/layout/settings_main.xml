<?xml version="1.0" encoding="utf-8"?>
    <dev.oneuiproject.oneui.layout.ToolbarLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:expanded="false"
        app:drawerBackAnimation="true"
        app:title="@string/settings_title"
        app:navigationIcon="@drawable/ic_oui_back"
        tools:isOpen="false"
        tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_location="main_content">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settings_fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:name="com.lich.updater.UI.Settings.SettingsPreferenceFragment" />

    </LinearLayout>

</dev.oneuiproject.oneui.layout.ToolbarLayout>
